{
  "excludes": [
    ".cache",
    ".Trash",
    "node_modules",
    "tmp",
    "temp",
    "~/Library/Caches",
    "~/Library/Logs",
    "~/.local/share/Trash",
    "~/.codex/.tmp",
    "~/.local/share/containers",
    "~/.local/share/docker"
  ],
  "maxExcludes": 128,
  "safeIgnored": [
    "node_modules",
    ".venv",
    "venv",
    "__pycache__",
    "*.pyc",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    ".tox",
    ".gradle",
    ".next",
    ".nuxt",
    ".turbo",
    ".cache",
    "coverage",
    ".DS_Store",
    "dist",
    "build",
    "target"
  ]
