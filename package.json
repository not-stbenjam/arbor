{
  "name": "arbor-desktop",
  "version": "0.2.0",
  "description": "A quiet desktop home for your Git worktrees",
  "author": "Arbor contributors",
  "license": "MIT",
  "private": true,
  "main": "desktop/main.cjs",
  "desktopName": "io.github.stbenjam.arbor.desktop",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prestart": "node scripts/build-desktop.cjs --prepare",
    "start": "electron .",
    "desktop:package": "node scripts/build-desktop.cjs",
    "desktop:dir": "node scripts/build-desktop.cjs --dir",
    "test:desktop": "node --test desktop/*.test.cjs desktop/common/*.test.cjs",
    "pretest:e2e": "node scripts/build-desktop.cjs --prepare",
    "test:e2e": "node scripts/e2e/run.cjs --skip scale-large",
    "test:e2e:scale": "node scripts/e2e/run.cjs --jobs 1 scale-large",
    "pretest:stress": "node scripts/build-desktop.cjs --prepare",
    "test:stress": "node scripts/stress/run.cjs",
    "test:scripts": "node --test scripts/*.test.cjs"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  }
}
